string pet = "Pantera"
string especie = "gato"
int idade = 3
float peso = 3.0

feed pet 50.0
feed pet 80.0
feed pet 45.0
feed pet 90.0
feed pet 30.0

if idade >= 10 {
    vet pet "Recomanda-se check-up geriatrico"
} 

if peso >= 3.5 && peso <= 5.0 {
    feed pet 30.0
}

else{
    feed pet 0.0
    vet pet "Recomenda-se consulta para tratar peso."
}