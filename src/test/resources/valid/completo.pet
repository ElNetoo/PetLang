string pet = "Rex"
string especie = "cachorro"
int idade = 9
int dias = 0
float peso = 14.5

while dias < 6 {
    feed pet 150.0
    dias = dias + 1
}

if idade >= 8 {
    vet pet "Recomenda-se check-up geriatrico"
} 

if peso >= 8.0 && peso <= 15.0 {
    feed pet 150.0
}

else{
    feed pet 0.0
    vet pet "Recomenda-se consulta para tratar peso."
}